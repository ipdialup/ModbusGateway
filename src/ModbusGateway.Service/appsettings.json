{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    },
    "EventLog": {
      "LogLevel": { "Default": "Warning" }
    }
  },
  "Gateway": {
    "Serial": {
      "PortName": "COM4",
      "BaudRate": 9600,
      "Parity": "None",
      "DataBits": 8,
      "StopBits": "One",
      "DtrEnable": true,
      "RtsEnable": false,
      "ReopenDelayMs": 5000
    },
    "Tcp": {
      "Bind": "0.0.0.0",
      "Port": 502,
      "MaxClients": 8,
      "IdleTimeoutSeconds": 600
    },
    "ResponseTimeoutMs": 1000,
    "InterFrameDelayMs": 50,
    "ReadRetries": 1,
    "StatusPort": 5021,
    "LogFolder": "C:\\ProgramData\\ModbusGateway\\logs",
    "LogRetentionDays": 30
  }
}
